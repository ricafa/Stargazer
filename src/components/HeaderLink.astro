---
import type { HTMLAttributes } from 'astro/types';
import { url } from '../utils/url';

type Props = HTMLAttributes<'a'>;

// `href` é sempre um caminho interno simples (ex.: "/blog"); o prefixo do
// GitHub Pages é aplicado aqui, num lugar só.
const { href, class: className, ...props } = Astro.props;
const pathname = '/' + Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/^\//, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={url(String(href))} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
